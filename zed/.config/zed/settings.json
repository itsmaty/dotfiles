// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_install_extensions": {
    "aurora-theme": true,
    "charmed-icons": true,
    "aura-theme": true,
    "tokyo-night": true,
    "one-dark-pro": true,
    "plantuml": true,
    "java": true,
    "emmet": true,
    "jsp": true
  },
  "diff_view_style": "split",
  "format_on_save": "off",
  "icon_theme": "Base Charmed Icons",
  "git_panel": {
    "tree_view": false,
    "sort_by_path": false
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    }
  },
  "agent": {
    "profiles": {
      "aks": {
        "name": "Aks",
        "tools": {
          "create_thread": true,
          "diagnostics": true,
          "fetch": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "read_file": true,
          "grep": true,
          "skill": true,
          "spawn_agent": true,
          "search_web": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "project_panel": {
    "dock": "left"
  },
  "cli_default_open_behavior": "existing_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Aurora",
  },
}
